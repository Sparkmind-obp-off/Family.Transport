{
  "name": "family-transport-manager",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.toml --ip 0.0.0.0 --port 3000",
    "build": "node scripts/build.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name family-transport-manager --branch main",
    "deploy:worker": "wrangler deploy --config wrangler.toml",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/api.test.mjs tests/security.test.mjs && python3 tests/schema_test.py",
    "test:ui": "node tests/ui.mjs",
    "db:local": "wrangler d1 migrations apply family-transport-manager --local",
    "db:remote": "wrangler d1 migrations apply family-transport-manager --remote",
    "validate:deploy": "wrangler deploy --config wrangler.toml --dry-run --outdir dist/worker-validation"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261004.1",
    "@playwright/test": "^1.55.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.2",
    "wrangler": "4.147.0"
  }
}
